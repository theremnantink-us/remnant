# ─── Database (MAMP defaults) ───────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=remnant_bd

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Security ───────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# Leave empty in development; set to your frontend origin(s) in production.
# Example: CORS_ORIGINS=https://remnant.studio,https://www.remnant.studio
CORS_ORIGINS=

# Initial admin seed (only used on first run, when admins table is empty).
# Set SEED_DEFAULT_ADMIN=0 to skip in production. Production defaults to skip.
SEED_DEFAULT_ADMIN=1
ADMIN_INITIAL_PASSWORD=change-me-now

# ─── Web Push (VAPID) ───────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=

# ─── Telegram (optional) ────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=
